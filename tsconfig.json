{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable",
      "dom.asynciterable"
    ],
    "rootDir": "src",
    "outDir": "web/dist",
    "sourceMap": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/tsp/compile.ts",
    "src/tsp/worker.ts",
    "src/tsp/*.generated.js"
  ]
}
